{
  "name": "desktop-electron",
  "version": "26.10.0",
  "description": "A simple and powerful personal finance system",
  "author": "Actual",
  "main": "build/desktop-electron/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "update-client": "bin/update-client",
    "build": "yarn build:dist && electron-builder",
    "build:dist": "tsgo && yarn copy-static-assets",
    "test": "vitest --run",
    "typecheck": "tsgo -b && tsc-strict",
    "copy-static-assets": "copyfiles --exclude 'build/**/*' **/*.html icons/**/* build/desktop-electron",
    "watch": "yarn build:dist && cross-env ACTUAL_DOCUMENT_DIR=\"../../data\" ACTUAL_DATA_DIR=\"../../data\" electron .",
    "e2e": "npx playwright test",
    "build:mas": "electron-builder --mac mas --arm64 --config.mac.bundleVersion=\"$(date -u +%Y%m%d%H%M)\"",
    "build:mas-dev": "electron-builder --mac mas-dev --arm64",
    "release:mas": "yarn build:mas && xcrun altool --upload-app -f dist/mas-arm64/Actual-mac-app-store-arm64.pkg --type macos --apiKey \"$APP_STORE_CONNECT_API_KEY_ID\" --apiIssuer \"$APP_STORE_CONNECT_API_ISSUER_ID\""
  },
  "dependencies": {
    "@actual-app/sync-server": "workspace:*",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@actual-app/core": "workspace:*",
    "@actual-app/web": "workspace:*",
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "1.61.1",
    "@types/copyfiles": "^2",
    "@typescript/native-preview": "beta",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "electron": "43.8.1",
    "electron-builder": "26.8.1",
    "typescript-strict-plugin": "^2.4.4",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "com.actualbudget.actual",
    "files": [
      "build",
      "!build/desktop-electron/{tests,vitest.config.*}",
      "!node_modules/@actual-app/web",
      "node_modules/@actual-app/web/build",
      "node_modules/@actual-app/web/package.json",
      "!node_modules/better-sqlite3/{benchmark,src,bin,docs,deps,prebuilds,build/Release/obj,build/Release/sqlite3.a,build/Release/test_extension.node}",
      "!**/*.js.map",
      "!**/stats.json",
      "!build/client-build/sql-wasm.wasm",
      "!build/loot-core/lib-dist/electron/{browser,bundle.mobile*}"
    ],
    "beforePack": "./build/desktop-electron/beforePackHook.js",
    "afterSign": "./build/desktop-electron/afterSignHook.js",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "icons/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "mas": {
      "artifactName": "${productName}-mac-app-store-${arch}.${ext}",
      "entitlements": "mas/entitlements.mas.plist",
      "entitlementsInherit": "mas/entitlements.mas.inherit.plist",
      "provisioningProfile": "mas/embedded.provisionprofile",
      "hardenedRuntime": false
    },
    "masDev": {
      "provisioningProfile": "mas/development.provisionprofile"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-linux-${arch}.${ext}",
      "extraResources": [
        "extra-resources/linux"
      ],
      "desktop": {
        "entry": {
          "Categories": "Finance;Office",
          "Keywords": "Budget;Finance;Money;Expenses;Savings;"
        }
      },
      "executableName": "actual"
    },
    "win": {
      "target": [
        {
          "target": "appx",
          "arch": [
            "ia32",
            "x64",
            "arm64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "ia32",
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icons/icon.png",
      "artifactName": "${productName}-windows-${arch}.${ext}"
    },
    "appx": {
      "identityName": "actualbudget.org.ActualBudget",
      "publisherDisplayName": "actualbudget.org",
      "displayName": "Actual Budget",
      "publisher": "CN=19454997-90E1-4473-879D-96D6A77A6056"
    },
    "npmRebuild": false
  },
  "productName": "Actual"
}
