exports[`mobile calculator false > amount preserves 3dp major units and clears 1`] = `
<input
  autocapitalize="none"
  data-testid="amount-input"
  inputmode="decimal"
  style="flex: 1 1 0%; text-align: center; position: absolute;"
  type="text"
  value="5.123"
/>
`;

exports[`mobile calculator false > split preserves 3dp major units and clears 1`] = `
<input
  class="css-1io3eos"
  data-focus-visible="true"
  data-focused="true"
  data-rac=""
  inputmode="decimal"
  style="font-size: 13px; text-align: right; min-width: 0px; font-feature-settings: "tnum", "ss01", "ss04";"
  value="5.123"
/>
`;

exports[`mobile calculator true > amount preserves 3dp major units and clears 1`] = `
<input
  autocapitalize="none"
  class="css-15w775m"
  data-focused="true"
  data-testid="amount-input"
  inputmode="none"
  placeholder="0.000"
  style="color: var(--color-numberPositive); scroll-margin-top: 100px; box-shadow: none; font-size: 14px; outline: 0px; height: 40px;"
  type="text"
  value="5.123"
/>
`;

