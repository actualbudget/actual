// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`desktop reads stored precision 0 and returns integers 1`] = `
<input
  class="css-1io3eos"
  data-rac=""
  inputmode="decimal"
  style="font-feature-settings: "tnum", "ss01", "ss04";"
  value="1,234"
/>
`;

