{
  // Standalone project for the Cloudflare Worker entry points. Kept out of the
  // sync-server project so Workers globals don't leak into the Node code.
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    // Matches sync-server, whose sources the entry points import.
    "strict": false,
    "strictFunctionTypes": true,
    "lib": ["ES2022"],
    "types": ["./worker-configuration.d.ts", "vite/client"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "worker-configuration.d.ts"]
}
